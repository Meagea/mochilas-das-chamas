{
  "name": "bornal-de-guerra",
  "version": "1.28.0",
  "description": "Bornal de Guerra: batalha de mochilas",
  "author": "Meagea",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.penaepincel.bornaldeguerra",
    "productName": "Bornal de Guerra",
    "files": [
      "main.js",
      "index.html",
      "jogo.html"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Bornal de Guerra"
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
